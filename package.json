    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.68.0",
    "react-scroll": "^1.9.3",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.1.13"
