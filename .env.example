# =============================================================================
# Environment-Variablen – Andreas Crncic GmbH / bauunternehmen.saarland
#
# Diese Datei ist eine VORLAGE und enthält KEINE echten Secrets.
# Lokal kopieren nach `.env.local` (wird von Git ignoriert).
# In Production werden die Werte in den Vercel Project Settings gesetzt.
# =============================================================================


# -----------------------------------------------------------------------------
# reCAPTCHA v3  (PFLICHT in Production)
# -----------------------------------------------------------------------------
# Beide Keys stammen aus derselben reCAPTCHA-v3-Property in der Google Admin
# Console. Dort müssen die Domains `bauunternehmen.saarland` und
# `www.bauunternehmen.saarland` eingetragen sein (für lokale Entwicklung
# zusätzlich `localhost`).
#
# WICHTIG: Fehlt RECAPTCHA_SECRET_KEY in Production, werden Einsendungen
# abgewiesen (fail-closed). Das Formular läuft NICHT ungeschützt weiter.

# Öffentlicher Site Key – landet im Client-Bundle.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Geheimer Server Key – NUR serverseitig, niemals mit NEXT_PUBLIC_ prefixen.
RECAPTCHA_SECRET_KEY=


# -----------------------------------------------------------------------------
# reCAPTCHA – optionale Feinsteuerung
# -----------------------------------------------------------------------------
# Mindest-Score (0.0 – 1.0). Ohne Angabe: 0.5 (Google-Empfehlung als Startwert).
# Nach ein paar Wochen anhand der echten Score-Verteilung in der reCAPTCHA
# Admin Console nachjustieren. Ungültige Werte fallen auf den Default zurück.
# RECAPTCHA_MIN_SCORE=0.5

# Zusätzlich erlaubte Hostnames für die siteverify-Prüfung, kommasepariert.
# Normalerweise NICHT nötig – die Produktionsdomain und ihre www-Variante sind
# fest hinterlegt, Preview- und localhost-Hosts werden pro Umgebung ergänzt.
# RECAPTCHA_ALLOWED_HOSTNAMES=

# Development-Fallback: erlaubt Absenden OHNE reCAPTCHA-Verifikation.
# Greift ausschliesslich ausserhalb von Production und muss bewusst gesetzt
# werden. Niemals in Vercel Production konfigurieren.
# CONTACT_ALLOW_INSECURE_DEV=true


# -----------------------------------------------------------------------------
# Formcarry  (PFLICHT in Production)
# -----------------------------------------------------------------------------
# Ziel-Endpoint des Kontaktformulars, z. B. https://formcarry.com/s/<form-id>.
# Kein Fallback im Code: Fehlt die Variable, werden Einsendungen abgewiesen
# (fail-closed) und der Grund wird serverseitig geloggt.
#
# HINWEIS: In den Formcarry-Einstellungen muss reCAPTCHA AKTIV sein – mit dem
# Secret derselben v3-Property wie NEXT_PUBLIC_RECAPTCHA_SITE_KEY. Formcarry
# prüft das zweite Token und schützt so den öffentlich bekannten Endpoint gegen
# direkte Bot-Requests (Details: docs/kontaktformular-schutz.md).
FORMCARRY_ENDPOINT=


# -----------------------------------------------------------------------------
# Analytics (optional)
# -----------------------------------------------------------------------------
# Plausible-Events auch auf Vercel-Preview-Deployments senden.
# NEXT_PUBLIC_ENABLE_PREVIEW_TRACKING=false
